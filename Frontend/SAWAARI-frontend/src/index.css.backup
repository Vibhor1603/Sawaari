}

@media (min-width: 640px) {
  .btn-full-mobile {
    @apply w-auto;
  }
}

/* Button Alignment Utilities */
.btn-center {
  @apply mx-auto;
}

.btn-left {
  @apply mr-auto;
}

.btn-right {
