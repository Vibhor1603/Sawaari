/* Button Stack Utilities */
.btn-stack-mobile {
  @apply flex flex-col gap-3;
}

@media (min-width: 640px) {
  .btn-stack-mobile {
    @apply flex-row gap-4;
  }
}

/* Button Width Constraints */
.btn-auto-width {
