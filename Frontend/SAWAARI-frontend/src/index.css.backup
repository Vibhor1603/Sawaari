/* Import Google Fonts - Inter for modern, clean typography */
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800;900&family=Kalam:wght@300;400;700&display=swap");

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Base styles for vibrant, modern look */
@layer base {
  * {
    @apply antialiased;
  }

  body {
    @apply font-sans text-white;
    background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  /* Enhanced animated background pattern with subtle colors */
  body::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(
        circle at 20% 80%,
        rgba(244, 185, 66, 0.08) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 20%,
        rgba(45, 80, 22, 0.08) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 40% 40%,
        rgba(244, 185, 66, 0.03) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 60% 60%,
        rgba(45, 80, 22, 0.05) 0%,
        transparent 50%
      );
    animation: backgroundShift 25s ease-in-out infinite;
    pointer-events: none;
    z-index: -1;
  }

  @keyframes backgroundShift {
    0%,
    100% {
      transform: translateX(0) translateY(0);
    }
    25% {
      transform: translateX(-15px) translateY(-15px);
    }
    50% {
      transform: translateX(15px) translateY(15px);
    }
    75% {
      transform: translateX(-8px) translateY(8px);
    }
  }

  /* Enhanced text readability */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    @apply font-semibold tracking-tight text-white;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  /* Improved paragraph readability */
  p {
    @apply text-gray-100 leading-relaxed;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }

  /* Enhanced link readability */
  a {
    @apply text-gray-100 hover:text-sawaari-yellow transition-colors duration-300;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }

  /* Better form text readability */
  input,
  select,
  textarea {
    @apply text-white placeholder-gray-400;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }

  /* Enhanced button text */
  button {
    @apply text-white font-medium;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }
}

/* Component styles following SAWAARI design guidelines */
@layer components {
  /* Enhanced Primary Button with subtle effects - Responsive */
  .btn-primary {
    @apply inline-flex items-center justify-center text-black font-semibold rounded-lg transition-all duration-300 hover:shadow-sawaari-subtle transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-sawaari-yellow/50 focus:ring-offset-2 focus:ring-offset-black disabled:opacity-50 disabled:cursor-not-allowed relative overflow-hidden;
    background: linear-gradient(135deg, #f4b942 0%, #e6a635 100%);
    box-shadow: 0 4px 15px rgba(244, 185, 66, 0.2);
    text-shadow: none;
    /* Responsive sizing */
    padding: 8px 16px;
    font-size: 14px;
    min-width: 100px;
    max-width: 200px;
  }

  @media (min-width: 480px) {
    .btn-primary {
      padding: 10px 20px;
      font-size: 14px;
      min-width: 120px;
      max-width: 250px;
    }
  }

  @media (min-width: 768px) {
    .btn-primary {
      padding: 12px 24px;
      font-size: 16px;
      min-width: 140px;
      max-width: 300px;
    }
  }

  @media (min-width: 1024px) {
    .btn-primary {
      padding: 12px 32px;
      font-size: 16px;
      min-width: 160px;
    }
  }

  .btn-primary::before {
    content: "🛺";
    position: absolute;
    top: -20px;
    right: -20px;
    font-size: 2rem;
    opacity: 0.1;
    transform: rotate(15deg);
    transition: all 0.3s ease;
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #e6a635 0%, #d49429 100%);
    box-shadow: 0 6px 25px rgba(244, 185, 66, 0.4);
    transform: scale(1.05) translateY(-2px);
  }

  .btn-primary:hover::before {
    opacity: 0.2;
    transform: rotate(25deg) scale(1.1);
  }

  .btn-primary:focus {
    box-shadow: 0 0 0 3px rgba(244, 185, 66, 0.3);
  }

  /* Enhanced Secondary Button - Responsive */
  .btn-secondary {
    @apply inline-flex items-center justify-center text-white font-semibold rounded-lg transition-all duration-300 hover:shadow-lg transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 focus:ring-offset-black disabled:opacity-50 disabled:cursor-not-allowed relative overflow-hidden;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.05) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    /* Responsive sizing */
    padding: 8px 16px;
    font-size: 14px;
    min-width: 100px;
    max-width: 200px;
  }

  @media (min-width: 480px) {
    .btn-secondary {
      padding: 10px 20px;
      font-size: 14px;
      min-width: 120px;
      max-width: 250px;
    }
  }

  @media (min-width: 768px) {
    .btn-secondary {
      padding: 12px 24px;
      font-size: 16px;
      min-width: 140px;
      max-width: 300px;
    }
  }

  @media (min-width: 1024px) {
    .btn-secondary {
      padding: 12px 32px;
      font-size: 16px;
      min-width: 160px;
    }
  }

  .btn-secondary::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.1),
      transparent
    );
    transition: left 0.5s ease;
  }

  .btn-secondary:hover {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.15) 0%,
      rgba(255, 255, 255, 0.08) 100%
    );
    border-color: rgba(255, 255, 255, 0.3);
    transform: scale(1.05) translateY(-2px);
  }

  .btn-secondary:hover::before {
    left: 100%;
  }

  .btn-secondary:focus {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.2);
  }

  /* Enhanced Card Component with better readability */
  .card {
    @apply bg-black/40 border border-white/10 rounded-xl p-6 transition-all duration-300 hover:shadow-sawaari-lg hover:border-sawaari-yellow/30 relative;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    z-index: 10; /* Ensure cards appear above floating rickshaws */
  }

  .card h3 {
    @apply text-white font-semibold mb-2;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .card p {
    @apply text-gray-200 leading-relaxed;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }

  /* Enhanced Glass Effect */
  .glass {
    @apply bg-white/5 backdrop-blur-md border border-white/10 rounded-xl;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  .glass::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.05) 50%,
      rgba(255, 255, 255, 0.02) 100%
    );
    border-radius: inherit;
    pointer-events: none;
    z-index: -1;
  }

  /* Enhanced Strong Glass Effect with dark green accents */
  .glass-strong {
    @apply bg-white/10 backdrop-blur-lg border border-white/20 rounded-xl relative overflow-hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  .glass-strong:hover {
    @apply border-sawaari-green/40;
    box-shadow: 0 12px 40px rgba(45, 80, 22, 0.2);
  }

  /* Enhanced Form Input with better readability */
  .form-input {
    @apply w-full px-4 py-3 bg-black/30 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sawaari-green/50 focus:border-sawaari-green/50 transition-all duration-300 backdrop-blur-sm;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }

  .form-input:focus {
    @apply bg-black/40 border-sawaari-green/50;
    box-shadow: 0 0 0 3px rgba(45, 80, 22, 0.2);
  }

  .form-input:hover {
    @apply border-white/30 bg-black/35;
  }

  .form-input::placeholder {
    @apply text-gray-400;
  }

  /* Enhanced Section Components */
  .section {
    @apply py-20 relative;
    z-index: 5; /* Ensure sections appear above floating rickshaws */
  }

  .section-dark {
    @apply bg-black/30;
  }

  .section-light {
    @apply bg-white/5;
  }

  .section-gradient {
    background: linear-gradient(
      135deg,
      rgba(244, 185, 66, 0.05) 0%,
      rgba(45, 80, 22, 0.05) 100%
    );
  }

  /* Enhanced Container */
  .container-sawaari {
    @apply max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative;
    z-index: 10; /* Ensure containers appear above floating rickshaws */
  }

  /* Enhanced Rickshaw Decoration */
  .rickshaw-decoration {
    @apply relative;
  }

  .rickshaw-decoration::before {
    content: "🛺";
    @apply absolute -top-2 -right-2 text-lg opacity-60 animate-subtle-float;
  }

  /* Enhanced Route Line */
  .route-line {
    @apply relative;
  }

  .route-line::after {
    content: "";
    @apply absolute top-0 left-0 w-full h-full bg-gradient-to-r from-transparent via-sawaari-green/30 to-transparent;
    animation: routeFlow 3s ease-in-out infinite;
  }

  @keyframes routeFlow {
    0%,
    100% {
      transform: translateX(-100%);
    }
    50% {
      transform: translateX(100%);
    }
  }

  /* Enhanced Wheel Accent */
  .wheel-accent {
    @apply relative;
  }

  .wheel-accent::before {
    content: "";
    @apply absolute inset-0 border-2 border-sawaari-green rounded-full animate-wheel-rotate;
  }

  /* Enhanced Gradient Text */
  .gradient-text-sawaari {
    background: linear-gradient(135deg, #f4b942 0%, #e6a635 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gradient-text {
    background: linear-gradient(135deg, #ffffff 0%, #e5e5e5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* Enhanced Animations */
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  .animate-bounce-slow {
    animation: bounce-slow 3s ease-in-out infinite;
  }

  @keyframes bounce-slow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }

  @keyframes pulse-slow {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  /* Enhanced Subtle Animations */
  .animate-subtle-fade {
    animation: subtleFade 8s ease-in-out infinite;
  }

  .animate-subtle-float {
    animation: subtleFloat 6s ease-in-out infinite;
  }

  .animate-slide-up {
    animation: slideUp 0.8s ease-out;
  }

  .animate-scale-in {
    animation: scaleIn 0.6s ease-out;
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out;
  }

  @keyframes subtleFade {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.8;
    }
  }

  @keyframes subtleFloat {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  @keyframes slideUp {
    0% {
      transform: translateY(30px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @keyframes scaleIn {
    0% {
      transform: scale(0.9);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes fadeInUp {
    0% {
      transform: translateY(20px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Enhanced Drift Animation */
  .animate-drift {
    animation: drift 10s ease-in-out infinite;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translateX(0) translateY(0) rotate(0deg);
    }
    25% {
      transform: translateX(10px) translateY(-5px) rotate(2deg);
    }
    50% {
      transform: translateX(-5px) translateY(10px) rotate(-1deg);
    }
    75% {
      transform: translateX(-10px) translateY(-5px) rotate(3deg);
    }
  }

  /* Enhanced Floating Auto Rickshaws */
  .animate-rickshaw-float {
    animation: rickshawFloat 15s ease-in-out infinite;
  }

  @keyframes rickshawFloat {
    0%,
    100% {
      transform: translateX(0) translateY(0) rotate(0deg) scale(1);
      opacity: 0.05;
    }
    25% {
      transform: translateX(20px) translateY(-10px) rotate(5deg) scale(1.1);
      opacity: 0.08;
    }
    50% {
      transform: translateX(-15px) translateY(15px) rotate(-3deg) scale(0.9);
      opacity: 0.06;
    }
    75% {
      transform: translateX(-25px) translateY(-8px) rotate(8deg) scale(1.05);
      opacity: 0.07;
    }
  }

  /* Enhanced Pulse Animation */
  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }

  @keyframes pulse-slow {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }

  /* Enhanced Bounce Animation */
  .animate-bounce-slow {
    animation: bounce-slow 3s ease-in-out infinite;
  }

  @keyframes bounce-slow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  /* Enhanced Wiggle Animation */
  .animate-wiggle {
    animation: wiggle 2s ease-in-out infinite;
  }

  @keyframes wiggle {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(2deg);
    }
    75% {
      transform: rotate(-2deg);
    }
  }

  /* Enhanced Glow Animation */
  .animate-glow {
    animation: glow 2s ease-in-out infinite;
  }

  @keyframes glow {
    0%,
    100% {
      box-shadow: 0 0 5px rgba(244, 185, 66, 0.3);
    }
    50% {
      box-shadow: 0 0 20px rgba(244, 185, 66, 0.6);
    }
  }

  /* Enhanced Shimmer Effect */
  .animate-shimmer {
    animation: shimmer 3s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% {
      background-position: -200% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  /* Enhanced Scale Animation */
  .animate-scale-in {
    animation: scaleIn 0.6s ease-out;
  }

  @keyframes scaleIn {
    0% {
      transform: scale(0.9);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  /* Enhanced Slide Animation */
  .animate-slide-up {
    animation: slideUp 0.8s ease-out;
  }

  @keyframes slideUp {
    0% {
      transform: translateY(30px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Enhanced Fade Animation */
  .animate-fade-in {
    animation: fadeIn 1s ease-out;
  }

  @keyframes fadeIn {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  /* Enhanced Rickshaw Animations */
  .rickshaw-bounce {
    animation: rickshawBounce 2s ease-in-out infinite;
  }

  @keyframes rickshawBounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .rickshaw-wiggle {
    animation: rickshawWiggle 3s ease-in-out infinite;
  }

  @keyframes rickshawWiggle {
    0%,
    100% {
      transform: rotate(0deg);
    }
    25% {
      transform: rotate(2deg);
    }
    75% {
      transform: rotate(-2deg);
    }
  }

  /* Enhanced Gradient Border */
  .gradient-border {
    @apply relative;
  }

  .gradient-border::before {
    content: "";
    @apply absolute inset-0 rounded-lg p-[1px] bg-gradient-to-r from-sawaari-green via-sawaari-yellow to-sawaari-green;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }

  @keyframes gradientShift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Enhanced Neon Effects */
  .neon-yellow {
    text-shadow: 0 0 10px rgba(244, 185, 66, 0.5);
  }

  .neon-green {
    text-shadow: 0 0 10px rgba(45, 80, 22, 0.5);
  }

  @keyframes neonPulse {
    0%,
    100% {
      text-shadow: 0 0 10px rgba(244, 185, 66, 0.5);
    }
    50% {
      text-shadow: 0 0 20px rgba(244, 185, 66, 0.8);
    }
  }

  /* Enhanced Hover Effects */
  .hover-lift {
    @apply transition-all duration-300;
  }

  .hover-lift:hover {
    @apply transform -translate-y-2 shadow-sawaari-lg;
  }

  /* Enhanced Pattern Dots */
  .pattern-dots {
    background-image: radial-gradient(
      circle,
      rgba(244, 185, 66, 0.3) 1px,
      transparent 1px
    );
    background-size: 20px 20px;
    animation: patternMove 20s linear infinite;
  }

  @keyframes patternMove {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 40px 40px;
    }
  }

  /* Enhanced Rickshaw Hover */
  .rickshaw-hover {
    @apply relative overflow-hidden;
  }

  .rickshaw-hover::before {
    content: "🛺";
    @apply absolute -top-4 -right-4 text-2xl opacity-0 transition-all duration-300;
  }

  .rickshaw-hover:hover::before {
    @apply opacity-60 animate-rickshaw-bounce;
  }

  @keyframes rickshawBounce {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(10deg);
    }
  }

  /* Enhanced Tab Active */
  .tab-active {
    @apply relative text-sawaari-green font-semibold;
  }

  .tab-active::after {
    content: "";
    @apply absolute bottom-0 left-0 w-full h-0.5 bg-gradient-to-r from-sawaari-green to-sawaari-yellow rounded-full;
    animation: tabGlow 2s ease-in-out infinite;
  }

  @keyframes tabGlow {
    0%,
    100% {
      box-shadow: 0 0 5px rgba(45, 80, 22, 0.3);
    }
    50% {
      box-shadow: 0 0 15px rgba(45, 80, 22, 0.6);
    }
  }

  /* Enhanced Move Background */
  .animate-move-bg {
    animation: moveBg 20s ease-in-out infinite;
  }

  @keyframes moveBg {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Enhanced Map Overlay */
  .map-overlay {
    @apply absolute inset-0 bg-black/20 backdrop-blur-sm;
  }

  /* Enhanced Loading Rickshaw */
  .loading-rickshaw {
    @apply inline-block animate-rickshaw-spin;
  }

  /* Enhanced Skeleton Loading */
  .skeleton {
    @apply bg-white/10 animate-pulse rounded;
  }

  .skeleton-text {
    @apply h-4 bg-white/10 animate-pulse rounded;
  }

  .skeleton-avatar {
    @apply w-12 h-12 bg-white/10 animate-pulse rounded-full;
  }

  .skeleton-button {
    @apply h-10 bg-white/10 animate-pulse rounded-lg;
  }

  /* Enhanced Shimmer Effect */
  .shimmer {
    @apply relative overflow-hidden;
  }

  .shimmer::before {
    content: "";
    @apply absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent;
    animation: shimmer 2s infinite;
  }

  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }

  /* Enhanced Glass Card */
  .glass-card {
    @apply bg-white/5 backdrop-blur-md border border-white/10 rounded-xl p-6;
  }

  /* Enhanced Glass Button */
  .glass-button {
    @apply bg-white/10 backdrop-blur-sm border border-white/20 rounded-lg px-4 py-2 text-white hover:bg-white/20 transition-all duration-300;
  }

  /* Enhanced Status Indicators */
  .status-online {
    @apply w-3 h-3 bg-green-500 rounded-full;
  }

  .status-offline {
    @apply w-3 h-3 bg-gray-500 rounded-full;
  }

  .status-away {
    @apply w-3 h-3 bg-yellow-500 rounded-full;
  }

  /* Enhanced Text Readability Classes */
  .text-readable {
    @apply text-white font-medium;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .text-readable-secondary {
    @apply text-gray-200 font-normal;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }

  .text-readable-muted {
    @apply text-gray-300 font-normal;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }

  /* Enhanced Form Styling */
  .form-select {
    @apply w-full p-3 bg-black/30 border border-white/20 rounded-lg text-white focus:border-sawaari-green focus:ring-2 focus:ring-sawaari-green/20 focus:outline-none transition-all duration-300 backdrop-blur-sm text-sm;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }

  .form-select option {
    @apply text-white bg-black;
  }

  .form-label {
    @apply block text-xs font-semibold text-sawaari-yellow mb-1;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.2);
  }

  /* Leaflet Popup Custom Styling */
  .leaflet-popup-content-wrapper {
    background: transparent !important;
    backdrop-filter: none !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 0 !important;
  }

  .leaflet-popup-content {
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    border-radius: 0 !important;
  }

  .leaflet-popup-tip {
    background: transparent !important;
    border: none !important;
  }

  .leaflet-popup-close-button {
    color: #f4b942 !important;
    font-size: 14px !important;
    font-weight: bold !important;
    padding: 4px !important;
    background: rgba(0, 0, 0, 0.8) !important;
    border-radius: 50% !important;
    width: 20px !important;
    height: 20px !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.2s ease !important;
  }

  .leaflet-popup-close-button:hover {
    color: #e6a635 !important;
    background: rgba(244, 185, 66, 0.2) !important;
    transform: scale(1.1) !important;
  }

  /* Custom scrollbar for popup content */
  .leaflet-popup-content .overflow-y-auto::-webkit-scrollbar {
    width: 3px !important;
  }

  .leaflet-popup-content .overflow-y-auto::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1) !important;
    border-radius: 2px !important;
  }

  .leaflet-popup-content .overflow-y-auto::-webkit-scrollbar-thumb {
    background: rgba(244, 185, 66, 0.5) !important;
    border-radius: 2px !important;
  }

  .leaflet-popup-content .overflow-y-auto::-webkit-scrollbar-thumb:hover {
    background: rgba(244, 185, 66, 0.7) !important;
  }
}

/* Comprehensive Responsive Button System */

/* Button Container Classes */
.btn-container-center {
  @apply flex justify-center;
}

.btn-group-responsive {
  @apply flex flex-col sm:flex-row gap-3 sm:gap-4 items-center justify-center;
}

.responsive-btn-container {
  @apply flex justify-center items-center;
}

/* Specialized Button Classes */
.feature-btn {
  @apply btn-primary;
  /* Feature card buttons */
  min-width: 120px;
  max-width: 200px;
}

@media (min-width: 640px) {
  .feature-btn {
    min-width: 140px;
    max-width: 250px;
  }
}

.nav-btn {
  @apply btn-secondary;
  /* Navigation buttons */
  min-width: 80px;
  max-width: 150px;
}

@media (min-width: 640px) {
  .nav-btn {
    min-width: 100px;
    max-width: 180px;
  }
}

.cta-btn {
  @apply btn-primary;
  /* Call-to-action buttons */
  min-width: 140px;
  max-width: 250px;
}

@media (min-width: 640px) {
  .cta-btn {
    min-width: 180px;
    max-width: 300px;
  }
}

/* Mobile-First Button Constraints */
.btn-mobile-constrained {
  max-width: 80vw;
  width: auto;
}

/* Button Size Variants */
.btn-xs {
  padding: 6px 12px;
  font-size: 12px;
  min-width: 80px;
}

.btn-sm {
  padding: 8px 16px;
  font-size: 14px;
  min-width: 100px;
}

.btn-md {
  padding: 10px 20px;
  font-size: 14px;
  min-width: 120px;
}

.btn-lg {
  padding: 12px 24px;
  font-size: 16px;
  min-width: 140px;
}

.btn-xl {
  padding: 14px 28px;
  font-size: 18px;
  min-width: 160px;
}

